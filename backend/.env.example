# ==============================================================================
# SMART SCHOOL CONNECT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Only)
# ------------------------------------------------------------------------------
# MongoDB URI (Supports MongoDB Atlas, local MongoDB, or auto-fallback to embedded MongoMemoryServer in dev)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_school_connect?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=supersecret_production_school_connect_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Used for real email verification, invite onboarding, and password reset flows.
# Supports standard SMTP (Amazon SES, SendGrid SMTP, Mailgun, Brevo, or Ethereal for testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@schoolconnect.io
SMTP_PASS=your_app_specific_password_or_smtp_key
SMTP_FROM="Smart School Connect" <noreply@schoolconnect.io>

# Optional direct API keys for Resend or SendGrid
RESEND_API_KEY=
SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 4. SERVER-ONLY AI ASSISTANT PROVIDERS
# ------------------------------------------------------------------------------
# AI Orchestrator with automatic cascading fallback (Groq -> Gemini -> Nvidia)
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
DEFAULT_AI_PROVIDER=groq
